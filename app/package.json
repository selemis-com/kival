{
  "name": "kival-app",
  "version": "0.1.3",
  "description": "Web application for Kival.",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "pnpm --dir ../sdk/typescript build && vite",
    "build": "pnpm --dir ../sdk/typescript check && pnpm --dir ../sdk/typescript build && tsc --noEmit && vite build",
    "fmt": "biome format .. --write",
    "fmt:check": "biome format ..",
    "lint": "biome check .. --write",
    "lint:check": "biome check ..",
    "preview": "vite preview"
  },
  "dependencies": {
    "katex": "0.18.7",
    "kival-sdk": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
