# Exact Kival release tag published by the release workflow, for example v0.1.0.
KIVAL_VERSION=v0.1.0

# Replace every example secret before starting Kival.
# Keep the PostgreSQL password URL-safe because it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-password
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password

# Public HTTPS origin served by your reverse proxy. Do not include a trailing slash.
KIVAL_CANONICAL_URL=https://kival.example.com

# Optional additional exact HTTPS origins for passkey ceremonies, comma-separated.
KIVAL_ALLOWED_ORIGINS=

# Database pool settings for this single Kival server process.
KIVAL_DATABASE_MAX_CONNECTIONS=8
KIVAL_DATABASE_ACQUIRE_TIMEOUT_SECONDS=5

# Coarse API-key authentication attempts allowed per direct TCP peer and minute. Because Kival sees
# the reverse proxy as its direct peer, raise this value for higher-throughput deployments or set
# it to 0 only when the trusted edge applies an equivalent pre-authentication rate limit.
KIVAL_API_KEY_AUTHENTICATION_ATTEMPTS_PER_MINUTE=1200

KIVAL_GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30
