logging {
  level  = "info"
  format = "logfmt"
}

local.file_match "kival" {
  path_targets = [{
    "__path__" = "/var/log/kival/*.log",
    "job"      = "kival",
  }]
}

loki.source.file "kival" {
  targets    = local.file_match.kival.targets
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
